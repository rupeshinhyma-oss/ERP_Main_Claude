# =============================================================================
# ERP Backend - Environment Configuration Example
#
# Copy this file to `.env` and adjust values for your local environment.
# NEVER commit a real `.env` file to version control.
#
# NOTE: .env files do not support inline "# comment" text after a value
# (python-dotenv reads everything after "=" as part of the value). Every
# comment in this file is on its own line, above the setting it describes --
# keep that pattern when you edit your own .env, or values like
# CACHE_DEFAULT_TTL_SECONDS will fail to parse.
# =============================================================================

# --- Application ---
APP_NAME=ERP Backend
APP_VERSION=0.1.0
# ENVIRONMENT: local | development | staging | production | test
ENVIRONMENT=local
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Absolute path to the built frontend (the React app's `dist/` folder),
# for a same-origin production deploy where this backend also serves the
# built SPA. Leave unset for local development -- the Vite dev server
# proxies /api to this backend instead (see frontend/vite.config.ts).
# FRONTEND_DIST_DIR=/srv/erp/frontend/dist

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# --- Database ---
# Async URL used by the running application (asyncpg driver).
#
# Supabase: use the "Connection Pooling" string from
# Project Settings -> Database (port 6543, via PgBouncer), e.g.:
#   postgresql+asyncpg://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
# and set DATABASE_DISABLE_STATEMENT_CACHE=true below (required for
# PgBouncer transaction-pooling mode). If instead using Supabase's direct
# connection (port 5432), DATABASE_DISABLE_STATEMENT_CACHE can stay false.
DATABASE_URL=postgresql+asyncpg://postgres.sxfcuarreenirvdyconu:Inhyma%402026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_SECONDS=2.0
DATABASE_DISABLE_STATEMENT_CACHE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Timezone ---
APP_TIMEZONE=UTC

# --- Cache backend (Phase 5) ---
# CACHE_BACKEND: currently only "in_memory" is implemented; "redis" is a
# future extension point and requires no dependency until switched on.
CACHE_BACKEND=in_memory

# --- Built-in Memory Cache (Phase 5) ---
# Max entries before LRU eviction; 0 disables the cap.
CACHE_MAX_SIZE=10000
# CACHE_DEFAULT_TTL_SECONDS is intentionally left UNSET (not "KEY=" blank --
# an empty value fails to parse as an integer). Omitting it entirely makes
# entries live forever unless a TTL is given per-entry. To set a default
# TTL, uncomment the next line and give it a number of seconds:
# CACHE_DEFAULT_TTL_SECONDS=300
# How often the background sweep removes expired entries (seconds).
CACHE_CLEANUP_INTERVAL_SECONDS=60

# --- Authentication / JWT (Phase 2) ---
# MUST be overridden with a strong, random value in every non-local environment.
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-this-is-a-local-dev-only-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=erp-backend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password policy ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_SIZE=5
PASSWORD_MAX_AGE_DAYS=90

# --- Login security / account lockout / rate limiting ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Cookie support (optional secure-cookie delivery of the refresh token) ---
AUTH_USE_SECURE_COOKIES=false
AUTH_REFRESH_COOKIE_NAME=refresh_token

# --- Bootstrap / seed data (used only by scripts/seed.py) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345

# --- Queue / Background Worker (Phase 4) ---
# QUEUE_BACKEND: "database" = built-in DB-backed queue (currently the only
# implemented backend); "celery" is a future extension point.
QUEUE_BACKEND=database
# Seconds between idle polls.
QUEUE_WORKER_POLL_INTERVAL=5
# Default max retries per job.
QUEUE_WORKER_MAX_RETRIES=3
# Reset RUNNING jobs older than this many minutes (stuck-job recovery).
QUEUE_STUCK_JOB_TIMEOUT_MINUTES=30
